  <ControlTheme x:Key="SliderShared" TargetType="Slider">
    <!-- Class Accent -->
    <Style Selector="^.Accent">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryHueMidBrush}" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="assist:SliderAssist.ThumbForeground" Value="{DynamicResource SecondaryHueMidBrush}"/>
    </Style>

    <!-- Shared styles -->
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource NeumorphismDisabled}" />
    </Style>

    <Style Selector="^[TickPlacement=None] /template/ TickBar#TopTick">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[TickPlacement=None] /template/ TickBar#BottomTick">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^[TickPlacement=Outside] /template/ TickBar#TopTick">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[TickPlacement=Outside] /template/ TickBar#BottomTick">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^[TickPlacement=TopLeft] /template/ TickBar#TopTick">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^[TickPlacement=TopLeft] /template/ TickBar#BottomTick">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^[TickPlacement=BottomRight] /template/ TickBar#BottomTick">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^[TickPlacement=BottomRight] /template/ TickBar#TopTick">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>
  <!--NeumorphismSliderThumbHorizontal: raised (extruded) neumorphic knob-->
  <ControlTheme x:Key="NeumorphismSliderThumbHorizontal" BasedOn="{StaticResource ThumbSliderBase}" TargetType="Thumb">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False" UseLayoutRounding="True">
          <Panel ClipToBounds="False"
                 Width="{Binding $parent[Slider].Bounds.Height, Converter={StaticResource WidthToCustomValueConverter}, ConverterParameter=170%}"
                 Height="{Binding $parent[Slider].Bounds.Height, Converter={StaticResource WidthToCustomValueConverter}, ConverterParameter=170%}">
            <!--Raised (extruded) knob-->
            <Border Name="grip" Cursor="Hand" CornerRadius="1000" RenderTransformOrigin="50%,50%"
                    Background="{DynamicResource NeumorphismPaper}">
              <Border.BoxShadow>
                <MultiBinding Converter="{StaticResource AutoBoxShadowsConverter}" ConverterParameter="{x:Static naming:BoxShadowsStyle.FixedOutset}">
                  <Binding Path="$parent[Slider].Bounds.Height"/>
                  <DynamicResource ResourceKey="NeumorphismShadowLight" />
                  <DynamicResource ResourceKey="NeumorphismShadowDark" />
                </MultiBinding>
              </Border.BoxShadow>
            </Border>
            <!--Pressed (inset) overlay, cross-faded in while the knob is grabbed-->
            <Border Name="PART_PressedShadow" CornerRadius="1000" Opacity="0" IsHitTestVisible="False">
              <Border.BoxShadow>
                <MultiBinding Converter="{StaticResource AutoBoxShadowsConverter}" ConverterParameter="{x:Static naming:BoxShadowsStyle.FixedInset}">
                  <Binding Path="$parent[Slider].Bounds.Height"/>
                  <DynamicResource ResourceKey="NeumorphismShadowLight" />
                  <DynamicResource ResourceKey="NeumorphismShadowDark" />
                </MultiBinding>
              </Border.BoxShadow>
            </Border>
            <!--Accent value dot-->
            <Ellipse Name="dot" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Width="{Binding $parent[Slider].Bounds.Height, Converter={StaticResource WidthToCustomValueConverter}, ConverterParameter=45%}"
                     Height="{Binding $parent[Slider].Bounds.Height, Converter={StaticResource WidthToCustomValueConverter}, ConverterParameter=45%}"
                     Fill="{TemplateBinding Foreground}" />
            <ContentPresenter Name="inner" Background="Transparent" Content="{TemplateBinding assist:SliderAssist.ThumbContent}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
          </Panel>
          <ContentPresenter Name="bubble" Width="0" Height="0" IsHitTestVisible="False" ClipToBounds="False" RenderTransformOrigin="0.5,0.5" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <!--NeumorphismSliderThumbVertical: raised (extruded) neumorphic knob-->
