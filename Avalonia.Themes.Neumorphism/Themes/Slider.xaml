                  <Binding Path="$parent[Slider].Bounds.Width"/>
                  <DynamicResource ResourceKey="NeumorphismShadowLight" />
                  <DynamicResource ResourceKey="NeumorphismShadowDark" />
                </MultiBinding>
              </Border.BoxShadow>
            </Border>
            <!--Pressed (inset) overlay, cross-faded in while the knob is grabbed-->
            <Border Name="PART_PressedShadow" CornerRadius="1000" Opacity="0" IsHitTestVisible="False">
              <Border.BoxShadow>
                <MultiBinding Converter="{StaticResource AutoBoxShadowsConverter}" ConverterParameter="{x:Static naming:BoxShadowsStyle.FixedInset}">
                  <Binding Path="$parent[Slider].Bounds.Width"/>
                  <DynamicResource ResourceKey="NeumorphismShadowLight" />
                  <DynamicResource ResourceKey="NeumorphismShadowDark" />
                </MultiBinding>
              </Border.BoxShadow>
            </Border>
            <!--Accent value dot-->
            <Ellipse Name="dot" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Width="{Binding $parent[Slider].Bounds.Width, Converter={StaticResource WidthToCustomValueConverter}, ConverterParameter=45%}"
                     Height="{Binding $parent[Slider].Bounds.Width, Converter={StaticResource WidthToCustomValueConverter}, ConverterParameter=45%}"
                     Fill="{TemplateBinding Foreground}" />
            <ContentPresenter Name="inner" Background="Transparent" Content="{TemplateBinding assist:SliderAssist.ThumbContent}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
          </Panel>
          <ContentPresenter Name="bubble" Width="0" Height="0" IsHitTestVisible="False" ClipToBounds="False" RenderTransformOrigin="0.5,0.5" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>


  <ControlTheme x:Key="ThumbSliderBase" TargetType="Thumb">
    <!-- Transitions -->
    <Style Selector="^:not(.notransitions) /template/ Border#PART_PressedShadow">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:not(.notransitions) /template/ Border#grip">
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Default state -->
    <Style Selector="^ /template/ Border#PART_PressedShadow">
      <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- Hover: subtle lift -->
    <Style Selector="^:pointerover /template/ Border#grip">
      <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>

    <!-- Pressed / dragging: the knob presses into the surface (inset shadow fades in) -->
    <Style Selector="^:pressed /template/ Border#PART_PressedShadow">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:pressed /template/ Border#grip">
      <Setter Property="RenderTransform" Value="scale(0.94)" />
    </Style>

    <!-- Disabled -->
    <Style Selector="^:disabled /template/ Border#grip">
      <Setter Property="Background" Value="{DynamicResource NeumorphismDisabled}" />
    </Style>
    <Style Selector="^:disabled /template/ Ellipse#dot">
      <Setter Property="Fill" Value="{DynamicResource NeumorphismDisabled}" />
    </Style>

    <!--Discrete thumb value tooltip ("bubble")-->
    <Style Selector="^[Tag=True] /template/ ContentPresenter#bubble">
      <Setter Property="Content">
        <Template>
          <Grid Name="InnerBubble" HorizontalAlignment="Center" VerticalAlignment="Bottom" IsVisible="{TemplateBinding assist:ThumbAssist.ValueTooltip}"
                Width="{Binding Bounds.Width, ElementName=PART_ContentContainer}"
                Height="{Binding Bounds.Height, ElementName=PART_ContentContainer}"
                ColumnDefinitions="Auto" RowDefinitions="Auto, Auto" ClipToBounds="False"
                RenderTransform="translate(0px, -16px)">
            <Polygon Grid.Row="1" Points="0,0 4.5,5 9,0" HorizontalAlignment="Center" RenderTransform="translate(0px,-0.5px)"
                     Fill="{Binding Background, ElementName=PART_ContentContainer}"/>

            <Border Name="PART_Positioner" Background="Transparent" Padding="{Binding Padding, ElementName=PART_ContentContainer}">
              <TextBlock Classes="Caption" Text="{Binding Text, ElementName=InnerBubbleText}"
                         Margin="{Binding Margin, ElementName=InnerBubbleText}" Foreground="Transparent"/>
            </Border>
            <Border Name="PART_ContentContainer" Background="{DynamicResource NeumorphismToolTipBackground}"
                    Padding="4, 8" CornerRadius="2">

              <TextBlock Name="InnerBubbleText" Classes="Caption" Text="{Binding $parent[Slider].Value}"
                         Foreground="{DynamicResource NeumorphismBackground}"/>
            </Border>
          </Grid>
        </Template>
      </Setter>
    </Style>

    <Style Selector="^[Tag=True]:not(.notransitions) /template/ ContentPresenter#bubble">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="^[Tag=True] /template/ ContentPresenter#bubble">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="scale(0)" />
    </Style>
    <Style Selector="^[Tag=True]:pointerover /template/ ContentPresenter#bubble">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>

    <Style Selector="^[Tag=True] /template/ ContentPresenter#bubble TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidForegroundBrush}" />
    </Style>
    <Style Selector="^[Tag=True].Accent /template/ ContentPresenter#bubble TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryHueMidForegroundBrush}" />
    </Style>
  </ControlTheme>


  <!--NeumorphismHorizontalTrackRepeatButtonLeft-->
  <ControlTheme x:Key="NeumorphismHorizontalTrackRepeatButtonLeft" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="false" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Name="PART_SelectionRange" Background="{TemplateBinding Background}" HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="True"
              Height="{Binding $parent[Slider].Bounds.Height, Converter={StaticResource WidthMinusValueConverter}, ConverterParameter=20%}"
              CornerRadius="{Binding $parent[Slider].Bounds.Height, Converter={StaticResource HeightToCornerRadiusConverter}, ConverterParameter=2}"
              Width="{Binding $parent[Slider].Bounds.Width}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>


